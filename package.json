{
  "name": "clinik-os",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "build": "pnpm --filter @clinik/shared build && pnpm --filter @clinik/api build && pnpm api:client && pnpm --filter @clinik/web build",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @clinik/shared build && pnpm -r --if-present typecheck",
    "test": "pnpm --filter @clinik/api test",
    "db:migrate": "pnpm --filter @clinik/api db:migrate",
    "db:rollback": "pnpm --filter @clinik/api db:rollback",
    "admin:create": "node apps/api/dist/cli/create-admin.js",
    "api:openapi": "pnpm --filter @clinik/api openapi:generate",
    "api:client": "pnpm --filter @clinik/web api:client",
    "boundary:check": "depcruise --config dependency-cruiser.config.cjs apps/api/src apps/web/src packages/shared/src --output-type err"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.7",
    "dependency-cruiser": "^17.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
