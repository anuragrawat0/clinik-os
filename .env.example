# Copy to .env for local Docker Compose use. These passwords are development-only.
DB_NAME=clinik_os
POSTGRES_SUPERUSER_PASSWORD=local_postgres_superuser_password
CLINIC_MIGRATOR_PASSWORD=local_clinic_migrator_password
CLINIC_APP_PASSWORD=local_clinic_app_password
CLINIC_WORKER_PASSWORD=local_clinic_worker_password

MINIO_ROOT_USER=clinik_minio
MINIO_ROOT_PASSWORD=local_minio_root_password

# Reverse proxies whose X-Forwarded-For header the API trusts (comma-separated CIDRs).
# Empty = trust nobody (correct when the API is reached directly, e.g. `pnpm start:dev`).
# Docker Compose sets this itself to exactly the web container's static address (<WEB_IP>/32,
# default 172.28.0.10 on subnet 172.28.0.0/24); override WEB_IP / COMPOSE_SUBNET only if that
# range clashes with something on your machine.
TRUSTED_PROXY_CIDRS=
