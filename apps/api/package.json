{
  "name": "@clinik/api",
  "private": true,
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm openapi:generate",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "worker:dev": "tsx watch src/worker.ts",
    "worker:start": "node dist/worker.js",
    "db:migrate": "node dist/core/db/migrate.js up",
    "db:rollback": "node dist/core/db/migrate.js down",
    "openapi:generate": "tsx src/core/openapi/generate.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clinik/shared": "workspace:*",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.0.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.3",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@testcontainers/postgresql": "^11.10.0",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6"
  }
}
