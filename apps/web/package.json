{
  "name": "@clinik/web",
  "private": true,
  "files": [
    ".next",
    "dist-server",
    "next.config.ts"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.server.json && node dist-server/server.js --dev",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "api:client": "openapi-typescript ../api/openapi/openapi.json -o src/lib/api-client/schema.d.ts"
  },
  "dependencies": {
    "@clinik/shared": "workspace:*",
    "@tanstack/react-query": "^5.90.11",
    "next": "^16.4.6",
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.10.1"
  }
}
